# Card agent runtime
SERVICE_NAME=card-agent
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8088
FORWARD_MODE=local

# Foundry settings
SERVICE_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project>
SERVICE_MODEL_DEPLOYMENT=<your-model-deployment-name>

# Optional telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false

# Optional downstream delegation defaults
DOWNSTREAM_AGENT_TIMEOUT=30

# Optional account downstream agent route
ACCOUNT_AGENT_NAME=account-agent
ACCOUNT_AGENT_ID=

# Optional payment downstream agent route
PAYMENT_AGENT_NAME=payment-agent
PAYMENT_AGENT_ID=
