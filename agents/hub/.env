# Hub Agent environment variables
# Copy this file to .env and fill in the values

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://ai-agenthubspoke-dev-sdc.services.ai.azure.com/api/projects/proj-agenthubspoke-dev-sdc

# ── Service identity ──────────────────────────────────────────────────────────
SERVICE_NAME=hub-agent
APP_ENV=ENV_LCL
HOST=0.0.0.0
PORT=8089

# ── Forwarding mode ───────────────────────────────────────────────────────────
# foundry: invoke downstream agents by agent_name/agent_id in Azure AI Foundry
# local: invoke downstream agents by HTTP endpoint (for local multi-agent testing)
FORWARD_MODE=local

# ── Domain agent names (must match agent names registered in Azure AI Foundry) ─
CARD_AGENT_NAME=card-agent
CARD_AGENT_ID=card-agent
CARD_AGENT_URL=http://0.0.0.0:8088/responses

ACCOUNT_AGENT_NAME=account-agent
ACCOUNT_AGENT_ID=account-agent
ACCOUNT_AGENT_URL=

PAYMENT_AGENT_NAME=payment-agent
PAYMENT_AGENT_ID=
PAYMENT_AGENT_URL=

# ── Timeout per downstream agent call (seconds) ───────────────────────────────
DOMAIN_AGENT_TIMEOUT=30

# ── Observability (optional) ──────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=0c0d70c9-5bd9-4773-a3de-bc7283f04d76;IngestionEndpoint=https://swedencentral-0.in.applicationinsights.azure.com/;LiveEndpoint=https://swedencentral.livediagnostics.monitor.azure.com/;ApplicationId=6a63f5d3-37da-4105-b3e5-bb59c91dbdda
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
