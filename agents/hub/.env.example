# Hub agent runtime (local testing defaults)
SERVICE_NAME=hub-agent
HOST=0.0.0.0
PORT=8089
APP_ENV=ENV_LCL

# Forwarding mode
# foundry: invoke downstream agents in Azure AI Foundry
# local: invoke downstream agents via local HTTP endpoints
FORWARD_MODE=foundry

# Foundry settings (only used when FORWARD_MODE=foundry)
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project>

# Local domain agent routes
CARD_AGENT_NAME=card-agent
CARD_AGENT_ID=
CARD_AGENT_URL=http://localhost:8088/responses

ACCOUNT_AGENT_NAME=account-agent
ACCOUNT_AGENT_ID=
ACCOUNT_AGENT_URL=

PAYMENT_AGENT_NAME=payment-agent
PAYMENT_AGENT_ID=
PAYMENT_AGENT_URL=

# Optional telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false

# Timeout per downstream call (seconds)
DOMAIN_AGENT_TIMEOUT=30
