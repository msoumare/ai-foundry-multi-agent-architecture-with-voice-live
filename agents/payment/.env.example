# Payment agent runtime
SERVICE_NAME=payment-agent
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8091
FORWARD_MODE=local

# Foundry settings
SERVICE_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project>
SERVICE_MODEL_DEPLOYMENT=<your-model-deployment-name>

# Optional telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_USE_AAD_AUTH=false
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
