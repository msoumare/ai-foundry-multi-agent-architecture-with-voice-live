# Payment agent runtime
SERVICE_NAME=payment-agent
APP_ENV=ENV_LCL
HOST=0.0.0.0
PORT=8091

# Foundry settings
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL_DEPLOYMENT=<your-model-deployment-name>

# Optional telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_USE_AAD_AUTH=false
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
